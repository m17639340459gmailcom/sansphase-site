[Unit]
Description=Verified SANSPHASE community backup
After=sansphase-community.service

[Service]
Type=oneshot
User=sansphase-community
Group=sansphase-community
WorkingDirectory=/opt/sansphase-community/current
EnvironmentFile=/etc/sansphase-community/site.env
Environment=COMMUNITY_BACKUP_DIRECTORY=/var/backups/sansphase-community
ExecStart=/usr/bin/node scripts/scheduled-community-backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# SQLite read-only WAL snapshots may still need to create/update sidecar files.
ReadWritePaths=/var/backups/sansphase-community /var/lib/sansphase-community
TimeoutStartSec=21600
