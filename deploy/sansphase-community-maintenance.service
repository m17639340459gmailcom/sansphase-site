[Unit]
Description=SANSPHASE verified community backup retention
After=sansphase-community-backup.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /opt/sansphase-maintenance/maintenance.py --profile community --rotate-backups --offsite-receipt /var/log/sansphase-maintenance/community-offsite.json --plan /var/log/sansphase-maintenance/community-backup-rotation.json
UMask=0077
LogsDirectory=sansphase-maintenance
LogsDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/sansphase-community /etc/sansphase-community
ReadWritePaths=/var/backups/sansphase-community /var/log/sansphase-maintenance /run/lock
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle

