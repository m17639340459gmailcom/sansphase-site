[Unit]
Description=SANSPHASE verified backup retention
After=sansphase-backup.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /opt/sansphase-maintenance/maintenance.py --rotate-backups --plan /var/log/sansphase-maintenance/backup-rotation.json
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/sansphase /var/log/sansphase-maintenance /run/lock
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
