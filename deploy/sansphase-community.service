[Unit]
Description=SANSPHASE independent Hong Kong community
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=sansphase-community
Group=sansphase-community
WorkingDirectory=/opt/sansphase-community/current
EnvironmentFile=/etc/sansphase-community/site.env
ExecStart=/usr/bin/node scripts/start-community.mjs
Restart=on-failure
RestartSec=10
TimeoutStopSec=180
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sansphase-community
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sansphase-community

[Install]
WantedBy=multi-user.target
