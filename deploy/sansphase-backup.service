[Unit]
Description=SANSPHASE verified private backup
After=sansphase.service

[Service]
Type=oneshot
User=sansphase
Group=sansphase
WorkingDirectory=/opt/sansphase/current
EnvironmentFile=/etc/sansphase/site.env
EnvironmentFile=/etc/sansphase/backup.env
ExecStart=/usr/bin/node scripts/scheduled-backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/sansphase
TimeoutStartSec=6h
