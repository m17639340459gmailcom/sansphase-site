{
  "name": "sansphase-site",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "description": "SANSPHASE personal website with self-hosted Payload and frontend author mode.",
  "scripts": {
    "start": "node scripts/start.mjs",
    "build": "node scripts/build-site.mjs",
    "dev": "node scripts/dev.mjs",
    "preview": "node scripts/dev.mjs",
    "test:publishing": "node --test tests/payload-integration.test.mjs",
    "test:author": "node --test tests/payload-integration.test.mjs",
    "test": "node --experimental-vm-modules --test tests/*.test.mjs",
    "format": "prettier --write src/*.html src/*.css src/*.mjs scripts/*.mjs tests/*.mjs server.mjs",
    "cms:backup": "node scripts/backup-payload.mjs",
    "cms:restore": "node scripts/restore-payload.mjs",
    "cms:account": "node scripts/payload-account.mjs",
    "healthcheck": "node scripts/healthcheck.mjs",
    "release:prepare": "node scripts/prepare-publication.mjs"
  },
  "devDependencies": {
    "@react-three/test-renderer": "9.1.1",
    "draco3d": "1.5.7",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "postcss": "8.5.28",
    "prettier": "3.9.6"
  },
  "dependencies": {
    "@fontsource/new-tegomin": "5.3.0",
    "@payloadcms/db-sqlite": "3.89.0",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "a11y-dialog": "8.1.5",
    "busboy": "1.6.0",
    "lucide": "1.45.0",
    "motion": "13.2.0",
    "ogl": "1.0.11",
    "payload": "3.89.0",
    "plyr": "3.8.4",
    "react": "19.2.4",
    "react-colorful": "5.8.1",
    "react-dom": "19.2.4",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.4",
    "simple-icons": "16.31.0",
    "sonner": "2.0.8",
    "three": "0.186.0",
    "three.quarks": "0.17.1",
    "threejs-galaxy-shader": "1.0.2"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
