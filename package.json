{
  "name": "sansphase-site",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "description": "SANSPHASE personal website with self-hosted Payload and frontend author mode.",
  "scripts": {
    "start": "node scripts/start.mjs",
    "build": "pnpm check:types && node scripts/build-site.mjs",
    "check:types": "tsc --noEmit",
    "check:types:frontend-v2": "tsc --noEmit -p previews/hero-upgrade/tsconfig.json",
    "dev": "node scripts/dev.mjs",
    "preview": "node scripts/dev.mjs",
    "preview:morph": "node scripts/preview-morph.ts",
    "preview:components": "node scripts/preview-components.ts",
    "preview:community": "pnpm build && node scripts/catalog-fixture-preview.mjs",
    "preview:diagnostics": "node scripts/preview-diagnostics.ts",
    "preview:teahouse": "node scripts/preview-teahouse-local.ts",
    "preview:admin-console": "node scripts/preview-admin-console.ts",
    "preview:community-console": "node scripts/preview-community-console.ts",
    "test:teahouse": "node --test tests/teahouse-*.test.ts tests/teahouse-*.test.mjs tests/community-teahouse-*.test.ts",
    "test:publishing": "node --test tests/payload-integration.test.mjs",
    "test:author": "node --test tests/payload-integration.test.mjs",
    "test": "node --experimental-vm-modules --test tests/*.test.mjs tests/*.test.ts tests/community-layout/*.test.ts tests/community-atlas/*.test.ts",
    "format": "prettier --write src/*.html src/*.css src/*.mjs scripts/*.mjs tests/*.mjs server.mjs",
    "cms:backup": "node scripts/backup-payload.mjs",
    "cms:restore": "node scripts/restore-payload.mjs",
    "cms:account": "node scripts/payload-account.mjs",
    "healthcheck": "node scripts/healthcheck.mjs",
    "captcha:build": "node scripts/build-login-captcha.mjs",
    "captcha:preview": "node scripts/login-verification-preview.mjs",
    "release:prepare": "node scripts/prepare-publication.mjs"
  },
  "devDependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@hugeicons/core-free-icons": "4.3.3",
    "@hugeicons/react": "1.1.10",
    "@mui/icons-material": "7.3.11",
    "@mui/material": "7.3.11",
    "@paper-design/shaders-react": "0.0.81",
    "@react-three/test-renderer": "9.1.1",
    "@types/busboy": "^1.5.4",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/three": "~0.186.0",
    "draco3d": "1.5.7",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "lenis": "1.3.26",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "ra-i18n-polyglot": "5.15.4",
    "ra-language-english": "5.15.4",
    "react-admin": "5.15.4",
    "react-router-dom": "7.18.4",
    "swiper": "12.2.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@fontsource/new-tegomin": "5.3.0",
    "@payloadcms/db-sqlite": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "a11y-dialog": "8.1.5",
    "busboy": "1.6.0",
    "compressorjs": "1.4.0",
    "cropperjs": "2.2.0",
    "dom-serializer": "3.1.1",
    "htmlparser2": "12.0.0",
    "image-size": "2.0.4",
    "linkifyjs": "4.3.3",
    "lru-cache": "11.5.2",
    "lucide": "1.45.0",
    "motion": "13.2.0",
    "nodemailer": "10.0.9",
    "ogl": "1.0.11",
    "payload": "3.90.2",
    "plyr": "3.8.4",
    "react": "19.2.4",
    "react-colorful": "5.8.1",
    "react-dom": "19.2.4",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.5",
    "simple-icons": "16.31.0",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "sonner": "2.0.8",
    "three": "0.186.0",
    "three.quarks": "0.17.1",
    "threejs-galaxy-shader": "1.0.2",
    "web-vitals": "6.2.3"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
